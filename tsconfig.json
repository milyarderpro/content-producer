{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.ts",
    "supabase/tests/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "vitest.database.config.ts"
  ],
  "exclude": ["node_modules", "coverage", "artifacts", "supabase/functions"]
}

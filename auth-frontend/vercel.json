{
  "git": {
    "deploymentEnabled": false
  },
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/oauth/consent",
      "destination": "/index.html"
    },
    {
      "source": "/logout",
      "destination": "/index.html"
    },
    {
      "source": "/error",
      "destination": "/index.html"
    },
    {
      "source": "/phase-9-5",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
